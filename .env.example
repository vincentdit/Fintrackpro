# FinTrackPro environment configuration
# Copy to .env and fill in real values. NEVER commit .env or real secrets.

# Which data source the app uses: "mock" (default, no backend needed) or "plaid"
EXPO_PUBLIC_DATA_SOURCE=mock

# Base URL of YOUR backend that brokers Plaid (see ARCHITECTURE.md).
# The Plaid client_secret must live ONLY on this backend, never in the app.
EXPO_PUBLIC_API_BASE_URL=https://api.yourcompany.com

# Plaid environment: sandbox | development | production
EXPO_PUBLIC_PLAID_ENV=sandbox
