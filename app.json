{
  "expo": {
    "name": "FinTrackPro",
    "slug": "fintrackpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "fintrackpro",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fintrackpro.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock FinTrackPro."
      }
    },
    "android": {
      "package": "com.fintrackpro.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A7A54"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-secure-store", "expo-local-authentication"],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "plaidEnv": "sandbox"
    }
  }
}
